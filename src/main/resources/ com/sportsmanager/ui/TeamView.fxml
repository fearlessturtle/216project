<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sportsmanager.ui.TeamViewController"
            prefWidth="860" prefHeight="580"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1a237e; -fx-padding: 10 16 10 16;">
            <Label text="SQUAD MANAGEMENT"
                   style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="budgetLabel" text="Budget: $4.5M"
                   style="-fx-text-fill: #bbbbbb; -fx-font-size: 12;"/>
        </HBox>
    </top>

    <center>
        <VBox>
            <HBox spacing="2" style="-fx-background-color: #e8eaf6; -fx-padding: 6 10 0 10;">
                <Button fx:id="playersTabBtn" text="Players" onAction="#showPlayers"
                        style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand; -fx-padding: 4 12;"/>
                <Button fx:id="coachesTabBtn" text="Coaches" onAction="#showCoaches"
                        style="-fx-background-color: #e0e0e0; -fx-text-fill: #333; -fx-font-size: 12; -fx-cursor: hand; -fx-padding: 4 12;"/>
            </HBox>

            <VBox fx:id="playersPanel" VBox.vgrow="ALWAYS">
                <TableView fx:id="playersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName"     text="Name"     prefWidth="220"/>
                        <TableColumn fx:id="colPosition" text="Pos"      prefWidth="70"/>
                        <TableColumn fx:id="colRating"   text="Rating"   prefWidth="80"/>
                        <TableColumn fx:id="colStatus"   text="Status"   prefWidth="200"/>
                    </columns>
                    <placeholder><Label text="No players in squad."/></placeholder>
                </TableView>
            </VBox>

            <VBox fx:id="coachesPanel" VBox.vgrow="ALWAYS" visible="false" managed="false">
                <TableView fx:id="coachesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCoachName"       text="Name"       prefWidth="200"/>
                        <TableColumn fx:id="colCoachSpeciality" text="Speciality" prefWidth="120"/>
                        <TableColumn fx:id="colCoachExperience" text="Exp (yrs)"  prefWidth="90"/>
                        <TableColumn fx:id="colCoachBonus"      text="Bonus"      prefWidth="80"/>
                    </columns>
                    <placeholder><Label text="No coaches assigned."/></placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-background-color: #e8eaf6; -fx-padding: 8 12;">
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#goBack"
                    style="-fx-background-color: #757575; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>