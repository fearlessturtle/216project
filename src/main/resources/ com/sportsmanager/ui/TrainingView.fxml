<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sportsmanager.ui.TrainingController"
            prefWidth="860" prefHeight="580"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1a237e; -fx-padding: 10 16 10 16;">
            <Label text="WEEKLY TRAINING"
                   style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="weekLabel" text="Week 1"
                   style="-fx-text-fill: #bbbbbb; -fx-font-size: 12;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding><Insets topRightBottomLeft="14"/></padding>

            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #ddd; -fx-border-radius: 4;">
                <Label text="ASSIGN DRILLS"
                       style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #333;"/>
                <CheckBox fx:id="chkShooting"  text="Shooting Drills"  onAction="#updatePreview"/>
                <CheckBox fx:id="chkDefensive" text="Defensive Blocks" onAction="#updatePreview"/>
                <CheckBox fx:id="chkStamina"   text="Stamina Run"      onAction="#updatePreview"/>
                <CheckBox fx:id="chkPassing"   text="Passing Drills"   onAction="#updatePreview"/>
                <Separator/>
                <Label text="SELECT PLAYERS"
                       style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #333;"/>
                <ListView fx:id="playerListView" VBox.vgrow="ALWAYS" prefHeight="200"/>
                <Label fx:id="expectedGrowthLabel"
                       text="Expected attribute growth: +0 Overall"
                       style="-fx-text-fill: #2e7d32; -fx-font-size: 11;"/>
            </VBox>

            <VBox spacing="10" prefWidth="250"
                  style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #ddd; -fx-border-radius: 4;">
                <Label text="COACH STAFF"
                       style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #333;"/>
                <ListView fx:id="coachListView" VBox.vgrow="ALWAYS" prefHeight="200"/>
                <Label text="Selected Coach:" style="-fx-font-size: 11; -fx-text-fill: #666;"/>
                <Label fx:id="selectedCoachLabel" text="None"
                       style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                <Label fx:id="coachBonusLabel" text=""
                       style="-fx-text-fill: #1565c0; -fx-font-size: 11;"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-background-color: #e8eaf6; -fx-padding: 8 12;">
            <Label fx:id="statusLabel" text="" style="-fx-text-fill: #555; -fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#goBack"
                    style="-fx-background-color: #757575; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="Start Training" onAction="#startTraining"
                    style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>