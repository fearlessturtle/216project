<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sportsmanager.ui.LeagueViewController"
            prefHeight="600.0"
            prefWidth="900.0"
            style="-fx-background-color: #f5f5f5;">

    <!-- Top Section: Season Info and Next Fixture -->
    <top>
        <VBox style="-fx-padding: 15; -fx-spacing: 10; -fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <Label fx:id="seasonLabel" text="Season Week 1" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            
            <HBox style="-fx-spacing: 20;">
                <Label fx:id="weekLabel" text="Week: 1" style="-fx-font-size: 14; -fx-text-fill: #666666;"/>
                <Label fx:id="nextFixtureLabel" text="Next Fixture: TBD" style="-fx-font-size: 14; -fx-text-fill: #333333; -fx-font-weight: bold;"/>
            </HBox>
            
            <Label fx:id="nextOpponentLabel" text="Opponent: TBD" style="-fx-font-size: 12; -fx-text-fill: #999999;"/>
        </VBox>
    </top>

    <!-- Center Section: Standings Table -->
    <center>
        <VBox style="-fx-padding: 15; -fx-spacing: 10;">
            <Label text="League Standings" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            
            <TableView fx:id="standingsTable" 
                      prefHeight="350.0"
                      style="-fx-font-size: 12;">
                <columns>
                    <TableColumn fx:id="teamColumn" text="Team" prefWidth="200.0"/>
                    <TableColumn fx:id="playedColumn" text="P" prefWidth="50.0"/>
                    <TableColumn fx:id="winsColumn" text="W" prefWidth="40.0"/>
                    <TableColumn fx:id="drawsColumn" text="D" prefWidth="40.0"/>
                    <TableColumn fx:id="lossesColumn" text="L" prefWidth="40.0"/>
                    <TableColumn fx:id="pointsColumn" text="Pts" prefWidth="50.0"/>
                    <TableColumn fx:id="goalDifferenceColumn" text="GD" prefWidth="50.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom Section: Action Buttons -->
    <bottom>
        <HBox style="-fx-padding: 15; -fx-spacing: 10; -fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;"
              alignment="CENTER_RIGHT">
            <Button fx:id="trainingButton" 
                   text="Go to Training" 
                   style="-fx-padding: 10 20; -fx-font-size: 12; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;"/>
            
            <Button fx:id="proceedButton" 
                   text="Proceed to Match" 
                   style="-fx-padding: 10 30; -fx-font-size: 12; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
