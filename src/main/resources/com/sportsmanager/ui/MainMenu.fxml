<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.FlowPane?>
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.sportsmanager.ui.MainMenuController"
           stylesheets="@app.css"
           styleClass="main-root"
           prefWidth="1200" prefHeight="720">
    <Pane fx:id="backgroundPane" mouseTransparent="true">
        <Region styleClass="orb orb-one" />
        <Region styleClass="orb orb-two" />
        <Region styleClass="orb orb-three" />
        <Region styleClass="grid" />
        <Region styleClass="pitch-lines" />
    </Pane>

    <HBox alignment="CENTER" spacing="34" maxWidth="860" styleClass="menu-stage">
        <VBox spacing="14" alignment="CENTER_LEFT" styleClass="hero-copy-block">
            <Label text="MATCHDAY CONTROL" styleClass="eyebrow" />
            <Label fx:id="titleLabel" text="Sports Manager" styleClass="hero-title" wrapText="true" />
            <Label text="Pick a sport. Build your team. Dominate."
                   styleClass="hero-copy" wrapText="true" />
            <FlowPane hgap="8" vgap="8" prefWrapLength="280">
                <Label text="Football" styleClass="menu-chip-football" />
                <Label text="Basketball" styleClass="menu-chip-basketball" />
                <Label text="Save / Load" styleClass="menu-chip-save" />
            </FlowPane>
            <Label text="Crush your season. Save it. Come back for more."
                   styleClass="hero-note" wrapText="true" />
        </VBox>

        <VBox fx:id="menuCard" alignment="CENTER" spacing="16" styleClass="menu-card" maxWidth="360">
            <Label text="Jump in" styleClass="panel-title" />
            <Label text="Pick a sport. Go." styleClass="panel-subtitle" wrapText="true" />
            <ComboBox fx:id="sportComboBox" prefWidth="280" styleClass="sport-combo" />
            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="startButton" text="Start Game" onAction="#handleStartGame" styleClass="primary-action" />
                <Button fx:id="loadButton" text="Load Game" onAction="#handleLoadGame" styleClass="secondary-action" />
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="quitButton" text="Quit" onAction="#handleQuit" styleClass="ghost-action" />
            </HBox>
        </VBox>
    </HBox>
</StackPane>
