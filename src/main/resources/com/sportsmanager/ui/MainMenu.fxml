<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sportsmanager.ui.MainMenuController"
      alignment="CENTER" spacing="20" prefWidth="400" prefHeight="300">
    <Label fx:id="titleLabel" text="Sports Manager" style="-fx-font-size: 24;"/>
    <Button fx:id="startButton" text="Start Game" onAction="#handleStartGame"/>
</VBox>
