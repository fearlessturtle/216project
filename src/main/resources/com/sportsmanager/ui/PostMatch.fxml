<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sportsmanager.ui.PostMatchController"
      alignment="CENTER" spacing="20" prefWidth="400" prefHeight="300">
    <Label fx:id="homeTeamLabel" text="Home Team"/>
    <Label fx:id="homeScoreLabel" text="0"/>
    <Label text="-"/>
    <Label fx:id="awayScoreLabel" text="0"/>
    <Label fx:id="awayTeamLabel" text="Away Team"/>
    <Button fx:id="backButton" text="Back to Menu" onAction="#handleBackToMenu"/>
</VBox>
