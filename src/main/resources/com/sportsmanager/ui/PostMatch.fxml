<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sportsmanager.ui.PostMatchController"
            stylesheets="@app.css"
            prefWidth="1200" prefHeight="720"
            styleClass="postmatch-root">
    <top>
        <VBox spacing="8" styleClass="postmatch-header">
            <Label text="THE FINAL SCORE" styleClass="eyebrow"/>
            <Label text="That's it. Here's what went down." styleClass="status-line-light" wrapText="true"/>
        </VBox>
    </top>

    <center>
        <StackPane alignment="CENTER">
            <Region styleClass="orb orb-one"/>
            <Region styleClass="orb orb-two"/>
            <Region styleClass="orb orb-three"/>
            <VBox fx:id="resultCard" alignment="CENTER" spacing="20" maxWidth="680" styleClass="score-card result-card">
                <Label text="RESULT" styleClass="panel-title-light">
                    <VBox.margin>
                        <Insets top="18" bottom="12"/>
                    </VBox.margin>
                </Label>
                <Label fx:id="resultBannerLabel" text="VICTORY" styleClass="result-banner"/>
                <Label fx:id="resultNarrativeLabel"
                       text="That's the match."
                       styleClass="result-narrative"
                       wrapText="true"
                       maxWidth="560"/>
                <HBox alignment="CENTER" spacing="24">
                    <VBox alignment="CENTER" spacing="8">
                        <Label fx:id="homeTeamLabel" text="Home Team" styleClass="team-name"/>
                        <Label fx:id="homeScoreLabel" text="0" styleClass="score-number"/>
                    </VBox>
                    <Label text="VS" styleClass="score-divider"/>
                    <VBox alignment="CENTER" spacing="8">
                        <Label fx:id="awayTeamLabel" text="Away Team" styleClass="team-name"/>
                        <Label fx:id="awayScoreLabel" text="0" styleClass="score-number"/>
                    </VBox>
                </HBox>
                <HBox fx:id="resultStatRow" alignment="CENTER" spacing="10">
                    <VBox.margin>
                        <Insets top="14" bottom="18"/>
                    </VBox.margin>
                </HBox>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="action-rail dark-rail postmatch-footer">
            <BorderPane.margin>
                <Insets top="0" right="18" bottom="14" left="18"/>
            </BorderPane.margin>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="backButton" text="Back" onAction="#handleBackToMenu" styleClass="primary-action"/>
        </HBox>
    </bottom>
</BorderPane>
